# Trigger-Reply-Engine configuration. Copy to `.env` and adjust.
# The service is a stateless FastAPI API client. Every value below is optional.

# ── Gym base URL overrides (all optional) ─────────────────────────────────────
# Each gym works out of the box: its manifest (manifests/*.yaml) carries a
# default base_url (the hosted v1 deployment). Set one of these ONLY to
# redirect that gym elsewhere, e.g. for local/dev use against Docker Desktop:
#   SPOTHUB_BASE_URL=http://host.docker.internal:3000
#   SALES_EXPLORER_BASE_URL=http://host.docker.internal:3001
#
# The env var name for any gym (including future ones) is derived from its
# manifest `name` by convention: NAME.upper() + "_BASE_URL" (see
# app/registry.py:base_url_env_var) — no code change needed to add one.
SPOTHUB_BASE_URL=
SALES_EXPLORER_BASE_URL=

# ── Reply generation ──────────────────────────────────────────────────────────
# USE_LLM=0 (default) uses the deterministic template stub — no key/network needed.
# Set USE_LLM=1 and provide a key to generate replies with OpenAI.
USE_LLM=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=20

# ── Outbound HTTP (calls to the gym) ──────────────────────────────────────────
REQUEST_TIMEOUT=15
MAX_RETRIES=2
RETRY_BACKOFF=0.5

# ── Idempotency (per-instance; see README) ────────────────────────────────────
IDEMPOTENCY_TTL=900
IDEMPOTENCY_MAX_ENTRIES=10000

# ── Auth ───────────────────────────────────────────────────────────────────────
# Shared secret required on the X-API-Key header for /trigger and introspection.
# Leave unset for local dev; set before deploying anywhere network-reachable.
API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=*
# Override the manifests directory (defaults to ./manifests locally, /app/manifests in Docker).
# MANIFESTS_DIR=./manifests
